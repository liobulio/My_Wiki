{
  // Cloudflare deploy config for the daily brief.
  //
  // Cloudflare folded Pages into Workers, and the dashboard's "Build output directory" field is gone
  // — the static-assets directory is declared here instead. Only ./brief is uploaded, so the raw wiki
  // (positions, theses, sources) never reaches the published site.
  //
  // No build step: the HTML is generated by scripts/render_brief.py and committed, so the build
  // command stays empty. _headers and _redirects inside ./brief are honoured natively, which is what
  // gives us the noindex headers and the stable /latest URL.
  "name": "my-wiki-brief",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./brief"
  }
}
